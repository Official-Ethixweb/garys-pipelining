# Copy this file to .env.local and fill in real values. Without SMTP configured,
# forms still validate client-side but submissions fail server-side, and
# visitors see a "please call instead" fallback. See README.md for details.

# SMTP2Go (or any standard SMTP relay) credentials for sending lead emails.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Optional. "true" to force implicit TLS. Inferred from SMTP_PORT (465 = true) if unset.
SMTP_SECURE=

# The sending address. Its domain must be a verified sender in SMTP2Go.
MAIL_FROM=
# Admin inbox that receives lead notifications. Comma-separated for multiple recipients.
MAIL_TO=
# Optional. Comma-separated, silently BCC'd on every admin lead notification.
MAIL_BCC=

# Optional. Override the name/logo/colors used in outgoing emails. Defaults to
# src/lib/site-config.ts, which is correct for this project; only needed if
# this mail system is reused on a different project without also swapping
# site-config.ts.
MAIL_BRAND_NAME=
MAIL_BRAND_SHORT_NAME=
MAIL_BRAND_LOGO_URL=
MAIL_BRAND_PRIMARY_COLOR=
MAIL_BRAND_PRIMARY_DEEP_COLOR=
MAIL_BRAND_ACCENT_COLOR=

# Cloudflare Turnstile CAPTCHA, required on the estimate and partnership forms.
# NEXT_PUBLIC_ prefix means this one is exposed to the browser; that's expected,
# it's a site key, not a secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional, one-time. The Google Search Console HTML tag verification code.
# Only needed in Vercel's Production env vars.
GOOGLE_SITE_VERIFICATION=
